# Copy to .env and adjust for your machine/deployment.

# Base URL of ai-damage-assessment-service's server/ (Node API) -- used by
# src/services/aiDamageAssessmentApi.js. Defaults to http://localhost:8000
# in code if this isn't set, which is right for local dev only.
VITE_AI_SERVICE_URL=http://localhost:8000

# Base URL of ai-damage-assessment-service/auth-service (the standalone
# login backend for claim-workshop/claim-surveyor/preinspection-agent/
# preinspection-surveyor) -- used by src/services/authApi.js. Defaults to
# http://localhost:8010 in code if this isn't set.
VITE_AUTH_SERVICE_URL=http://localhost:8010

# Base URL of ai-damage-assessment-service/claims-service (Owner & Vehicle
# Details submissions + each portal's Dashboard claim list) -- used by
# src/services/claimsApi.js. Defaults to http://localhost:8020 in code if
# this isn't set.
VITE_CLAIMS_SERVICE_URL=http://localhost:8020
